      "payload": {
        "pack_id": "joint-armature-118-АСЦ-71",
        "verdicts": [
          {
            "case_id": "J-93cde5e452f20249889b9a78",
            "case_sha256": "db59e335d8cff50f4ac51e6fa6f019cebf5a2325eb3e8a6c9fbd13edec39e410",
            "decision": "both",
            "reason": "Лично повторно просмотрел полный оригинал и увеличение таблицыАСЦ наp118: все 6 отдельные проводные подстроки модели АСЦ-71 перечислены именно в её общем блоке. Все члены исходного спискаОлега соответствуют этим же вариантам, в том же порядке; rawзначения совпадают буквально с явно привязанными character-spans. Принимаю ОБА уровня: каждый исходный наш вариант остаётся отдельной строкой, списокОлега добавляется ТОЛЬКО как полный набор допустимых проводов для модели с явными memberbindings. Значение конкретной вариантной ячейки не заменять полным списком; ни одной новой марки/цифры/единицы здесь не создаётся. Это единая source-bound модель данных, а не голосование за потерю одного из двух уровней.",
            "source_evidence": [
              {
                "source_sha256": "c8cb0bf124607d1f5f9de18fc48d467033262b9f43c205a582b01521e5aaab4e",
                "page": 118,
                "bbox": [
