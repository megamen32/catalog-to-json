[Unit]
Description=Versioned catalogue conversion job %i

[Service]
Type=exec
WorkingDirectory=%h/apps/catalog-to-json
ExecStart=/usr/bin/python3 %h/apps/catalog-to-json/ops/run-job.py %h/.config/catalog-to-json/jobs/%i.json
MemoryHigh=4G
MemoryMax=6G
MemorySwapMax=0
CPUQuota=200%
TasksMax=512
IOWeight=50
Nice=10
RuntimeMaxSec=86500
TimeoutStopSec=60
KillMode=control-group
Restart=no
Environment=OMP_NUM_THREADS=2 OPENBLAS_NUM_THREADS=2 MKL_NUM_THREADS=2 NUMEXPR_NUM_THREADS=2 TOKENIZERS_PARALLELISM=false
StandardOutput=journal
StandardError=journal
