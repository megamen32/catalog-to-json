{
  "mcpServers": {
    "catalog": {
      "command": "uvx",
      "args": [
        "--from",
        "git+https://github.com/megamen32/catalog-to-json@v1.0.2",
        "catalog-json-mcp"
      ]
    },
    "catalog-review": {
      "command": "uvx",
      "args": [
        "--from",
        "git+https://github.com/megamen32/catalog-to-json@v1.0.2",
        "catalog-json-mcp",
        "--role",
        "reviewer"
      ]
    }
  }
}
